# Runs one deploy check. Paired with level0-autodeploy.timer, which
# fires it every couple of minutes; deploy.sh itself decides whether
# there is anything to do, so a tick with no new commits is a no-op and
# never restarts the service.
#
# Install:
#   sudo cp deploy/level0-autodeploy.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now level0-autodeploy.timer

[Unit]
Description=Deploy Level 0 when main has new commits
After=network-online.target level0.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/level0
ExecStart=/opt/level0/deploy/deploy.sh
# A failed check shouldn't be fatal — the next tick tries again.
SuccessExitStatus=0
TimeoutStartSec=600
